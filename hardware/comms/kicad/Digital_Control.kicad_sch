	(text "SPI0 master: GP4 MISO, GP6 SCK, GP7 MOSI\nA/B CS: GP14/15; IRQ: GP18/19\nA/B STBY: GP2/3; RESET: GP8/9\n16MHz clocks; dual-instance firmware port required."
		(exclude_from_sim no)
		(at 137.16 224.79 0)
