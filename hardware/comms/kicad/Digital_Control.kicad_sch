				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "de2d2aad-5f36-4394-a934-233578185a59")
	)
	(text_box "DIGITAL CONTROL — Raspberry Pi Pico module (RP2040-based). Handles BPSK/DBPSK encoding for TX, AFSK demodulation for RX, Si5351A configuration via I2C, and command processing. Using Pico module for prototype — all RP2040 support circuitry (flash, regulator, crystal) is on-module. Bare RP2040 redesign deferred to v2 flight board after RF chain validation."
		(exclude_from_sim no)
		(at 55.88 41.91 0)
		(size 134.62 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
