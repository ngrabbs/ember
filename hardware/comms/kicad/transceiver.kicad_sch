			)
			(justify left top)
		)
		(uuid "ccc502d9-f4cc-49e7-928e-0d433052ece2")
	)
	(text_box "\n * 2m BPF ( input filter )\n                    |\n * PSA4-5043+ LNA (+21 dB)\n                    |\n * ADE-1+ Mixer <- LO LPF <- CLK1\n                    | (+ 31 ohm term)\n * Sallen-Key LPF ( fc = 3.3kHz )\n                    |\n * MCP6022 Gain Stage ( x11 )\n                    |\n                    | -> Pico ADC\n\n* RX SMA <- 145.9 MHz antenna"
		(exclude_from_sim no)
		(at 293.37 116.84 0)
		(size -66.04 53.34)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
