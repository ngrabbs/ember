		(uuid "90682ddf-a536-470e-b28c-ad5f03296a2c")
	)
	(text_box "\n * 25 MHz XTAL -> PLL -> CLK0 (145.67 MHz)\n                                               CLK1 (145.90 MHz)\n                                               CLK2 (spare)"
