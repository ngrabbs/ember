		(uuid "b69dd803-f4d6-4e63-b46a-15d078cba9bf")
	)
	(text_box "| Net | Type | Description |\n|-----|------|-------------|\n| +3V3, +5V, GND, VBAT | Power port | Supply rails (global) |\n| I2C_SDA, I2C_SCL | Net label | I2C bus (Si5351A + IHU bus) |\n| CLK0_OUT, CLK1_OUT | Net label | Si5351A clock outputs |\n| BPSK_DATA | Net label | RP2040 → XOR modulator |\n| TX_OUT, RX_IN | Net label | RF paths to SMA connectors |\n| RX_BASEBAND | Net label | MCP6022 output → Pico ADC |"
		(exclude_from_sim no)
		(at 275.59 251.46 0)
		(size -111.76 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
