	(text "TX_ACTIVE low forces the tripler drive low.\nR35 provides the existing 10k reset pull-down.\nCLK1 / receive LO is unaffected.\nVerify 145.667 MHz waveform and off-state leakage on prototype."
		(exclude_from_sim no)
		(at 149.86 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e71a3ecd-2ff4-43c2-af4f-57e3e7869f21")
	)
	(text "437 MHz Band-Pass Filter"
		(exclude_from_sim no)
		(at 292.608 84.836 0)
		(effects
