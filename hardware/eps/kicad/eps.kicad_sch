	(text_box "CONNECTORS & TELEMETRY — Battery interface, CSKB H1 + H2 stack connectors for inter-board power and signal distribution, status LEDs, and test points for bench validation. All subsystem power and I2C telemetry routes through the CSKB H1/H2 connectors."
		(exclude_from_sim no)
		(at 175.26 26.67 0)
		(size -139.7 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
