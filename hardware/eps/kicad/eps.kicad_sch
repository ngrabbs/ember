		(uuid "74611720-b1db-47e8-98ce-0b02c32d9e64")
	)
	(text_box "Battery: 2S2P LG MJ1 18650 (7000mAh total, 6.0-8.4V). J5 (JST): permanent battery holder connection.  J6 (header): bench supply input for bring-up without battery.  \n\nWARNING: Do not connect bench supply and battery simultaneously unless bench supply is set to match battery voltage.  The LTC4162 PowerPath handles source arbitration, but bench supply on VBAT bypasses the charger path."
		(exclude_from_sim no)
