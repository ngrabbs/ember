  (text "Pin 1 = BOOST; EP29 = AGND\n29 distinct electrical pins/pads; repeated power pins remain separate."
    (at 60.96 180.34 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "228f0b74-fab8-41ed-a516-d7d222b9b148")
  )
  (text "Pin 1 = PBI; EP33 = VSS\nNC7/14/29 are internally unconnected; TI permits VSS ties."
    (at 218.44 180.34 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "538a301b-5b0c-4ba8-a718-62821f3f7f22")
  )
