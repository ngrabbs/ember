	(text "UART DEBUG — 3V3 / 115200 DEVELOPMENT"
		(at 25.4 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "21ab8c9c-dbfa-46e6-a180-d5d32b1b3755")
	)
	(text "MCU PA2(.9) TX -> U800A -> J800.2; J800.3 -> U800B -> PA3(.10) RX.\nJ800.1 is GND. NO supply pin; independently powered TTL adapter only. No RS-232 levels."
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3fdcfcc6-9551-4ff8-bd64-7d8c11b26434")
	)
	(text "TX input pull-up is board-local only.\nRX input pulls DOWN to avoid a direct external-to-rail resistor path.\nAbsent adapter reads BREAK; firmware must qualify idle-high / ignore absent-port errors."
		(at 25.4 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "98288bf3-c242-4ca5-be65-73e0cd4da6a8")
	)
	(text "U800C: VCC physical5 / GND physical2.\nStock power-unit field anchors cross pin strokes; field-position API unavailable.\nC800 local bypass; R806 is the deliberate permitted-rail bleed."
		(at 111.76 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "89c0d231-7355-4834-9028-6d4c46283f2a")
	)
	(text "ADAPTER / HARNESS CONDITIONS\n3.3V TTL UART; VOH>=2.4V, VOL<=0.4V under load.\nAdapter input leakage<=10uA; connector/cable load<=50pF.\nU800 input transition <=10ns/V must be measured.\n115200 baud does not establish edge-rate or error-rate acceptance."
		(at 292.1 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f75f68d8-00e1-4c68-a392-457ae6f9f07c")
	)
	(text "POWER-OFF SCREEN IS CONDITIONAL\nIoff<=2uA is specified at VCC=0 only.\n68k output bleeds: ~0.136V at2uA.\nR806 rail bleed: ~0.273V at4uA assumed total.\nThese are leakage-budget screens, NOT brownout proof.\nUndefined0..1.65V / combined interfaces / RBF still open.\nReserve1.2mA static plus dynamic current."
		(at 292.1 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d8b719d4-9927-4a9a-8616-8791b9428681")
	)
	(text "DEVELOPMENT ONLY: connector ESD/abuse, physical harness fit, input slew and brownout/backpower acceptance remain open.\nS03 severity / S11 visible field styling / inherited pagination API limits retained. No real PCB synchronization."
		(at 25.4 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ed35adb-9b64-4fc2-bca3-4d8f2cfb2463")
	)
