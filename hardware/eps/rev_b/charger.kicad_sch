		(at 27.94 22.86 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
				(color 0 255 0 1)
			)
			(justify left bottom)
		)
		(uuid "4092296c-4673-4284-9c4f-eb193ce66c8c")
	)
	(text "DEVELOPMENT CHARGER: 2S straps; ~0.97 A charge setting; input servo is NOT a source-current breaker"
		(at 27.94 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "34d295b9-843f-4623-a3e5-49c7b99c1cfb")
	)
	(text "OPEN: 35 V charger failed-short path to pack is NOT autonomously contained."
		(at 27.94 206.6 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "559249c3-0a22-40eb-b482-efb9a5eafcf9")
	)
	(text "BATT_PERMITTED = future protected + interlocked 2S source fixture; all Kelvin sensing stays after RBF."
		(at 27.94 212.09 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "64e00814-42dc-4bba-bc8a-b4e488836d95")
	)
	(text "No raw BMS VSS joins system GND. Pack thermistor is separate Semitec103AT-2; no dummy/bypass."
		(at 27.94 217.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "353fee5a-77dc-4c9a-87bf-f4602d2dce3b")
	)
	(text "Input MPPT/weak-solar loop, shared startup, minimum effective C/L, hot SOA and sensor limits remain open."
		(at 27.94 222.25 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8f3a9808-7fda-4e42-ac04-bd36de80ce50")
	)
	(text "SYS flag now models real passive PowerPath output; BOOST flag = internal diode + SW bootstrap energy."
		(at 27.94 227.33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e64d501e-a846-4f81-bc2c-94435aa6ae50")
	)
	(text "No autonomous 3V3 OV or final BMS/RBF hardware is implied. Custom-field S11 presentation remains API-limited."
