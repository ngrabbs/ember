	(text "SOLAR SOURCE:33.5V analog clamp, timed cutoff, automatic retry"
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "83fa78c6-a3de-4593-9613-e2d5752f78c2")
	)
	(text "DEVELOPMENT ONLY. SOLAR_PERMITTED is an external interlocked-solar fixture; physical RBF is not drawn."
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce937cdc-c291-42e1-a755-18338d3277ab")
	)
	(text "L600 limits input-short slew:require >=2.5uH through fault current.\nC608=10nF timer. Bias/OV/snubber follow SRC_FILTERED.\nHot SOA, actual source energy and magnetic qualification remain open."
		(at 241.3 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8b60267f-7f9e-4aeb-aa95-e45a41ed3c8b")
	)
	(text "HGATE support / gate-source clamps / controlled startup"
		(at 260.35 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0666491-bc34-4657-89f1-dcb6443ad9ac")
	)
	(text "SRC_FAULT:active-low global to MCU PC15; single47k R608 pullup to essential+3V3.\nSHDN and ENOUT intentionally NC; no MCU startup dependency."
		(at 175.26 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7510d0db-893f-4c68-894d-f09b6d4cab71")
	)
	(text "VIN_CHG is protected solar output for FUTURE charger PowerPath.\nIt is NOT joined to converter SYS_PWR_PERMITTED in this schematic.\nSource output bank98uF nominal; downstream/source energy remains unqualified."
		(at 213.36 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e538979f-1c26-4b4d-b4c6-652490b3985a")
	)
	(text "PV fixture <=1A; raw reservoir <=1uF;\nharness<=1uH;60V abnormal test only.\nSMBJ60A is not a blanket80V clamp.\nSnubber>=2uF effective through60V;\nactual source energy/hot leakage open."
		(at 25.4 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0a85042-d5d0-486b-921c-0eb852b76098")
	)
	(text "S03 native severity /S11 field presentation APIs remain open. Existing Panasonic review candidate reused.\nNo hot-SOA, arbitrary-source, physical-fit or complete EPS power qualification."
		(at 25.4 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
