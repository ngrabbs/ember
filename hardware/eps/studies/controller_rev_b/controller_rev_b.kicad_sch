	(text "EPS REV B CONTROLLER - DEVELOPMENT STUDY"
		(at 25.4 24.13 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7f25af2e-6ad4-4f03-ac8d-0b03f8c64259")
	)
	(text "Essential +3V3 is an external input; source/interlock, charger and pack manager not integrated."
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f1eef1a-2174-493a-85b3-0d7df0034633")
	)
	(text "U1 is STM32G0B1KET6N (N suffix). Pin 20 is VDDIO2; tied to VDD.\nPA11/PA12 mapping retained; USB/LSE not used. Verify UCPD reset configuration."
		(at 180.34 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "31493bde-a6cb-4a44-a0aa-93d13901d37c")
	)
	(text "16 MHz HSE bypass. No passive crystal.\nPlace C11/C12 locally at Y1 in layout; source-series option remains open."
		(at 25.4 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2112769c-3f0e-4d2e-9915-b19ce02ef7b3")
	)
	(text "PROTECTION INTERFACES - NOT YET INTEGRATED\nPA6: REC5_RESET -> existing 47k Q107 base path.\nPA7: REC5_FAULT, PC15: SRC_FAULT (active low).\nExisting 47k pullups reside on protection sheets.\n2 ms reset pulse, >=10 s cooldown, rail qualification.\nReset is not permission to bypass protection."
		(at 254 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dcbcb8ce-8a79-433b-8fc1-428ef66a6eff")
	)
	(text "J1 is logical SWD access only, not a physical connector.\n1 VTref (sense only), 2 SWDIO, 3 SWCLK, 4 NRST, 5 GND.\nNo injected probe power; power-off/backfeed review open."
		(at 254 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "156e0e2d-2195-43d1-896d-00fe39d61224")
	)
	(text "OPEN: ADC conditioning, local charger I2C, isolated pack SMBus/BTP,\nUART, interlock status and payload request. Required pins remain unconnected.\nNo EPS drive on IHU-owned COMMS_EN / PAYLOAD_EN or stack alert."
		(at 25.4 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "72eecb70-b616-41de-9333-3383e1982199")
	)
	(text "POLICY LIMIT: component rating fields are saved but required visible Arial\nfield placement is unsupported by this Konnect API (S11 remains open)."
		(at 25.4 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "762d96ad-665d-49b7-b78e-f206be81098b")
	)
