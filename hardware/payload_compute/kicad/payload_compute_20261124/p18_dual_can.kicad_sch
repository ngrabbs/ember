	)
	(text "H1.1 is CANL and H1.3 is CANH. Fit R2705 (120 ohms) only at a physical bus endpoint.\nJetson native CAN uses J3301.143 (RX) and J3301.145 (TX). EPS powers PAYLOAD before Linux receives commands."
		(exclude_from_sim no)
		(at 20.32 255.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
