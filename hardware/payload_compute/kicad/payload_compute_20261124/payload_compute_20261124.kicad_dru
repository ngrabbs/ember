	(condition "A.inDiffPair('CAM1_CSI_D0') && B.inDiffPair('CAM1_CSI_D0') && A.enclosedByArea('CSI_CAM1_D0_FFC_F') && B.enclosedByArea('CSI_CAM1_D0_FFC_F')")
	(constraint diff_pair_gap
		(min 0.15mm)
		(max 2.35mm)
	)
)

(rule
	"CSI_CAM1_D0_SOURCE_RETURN bounded ground return via"
	(condition "A.Type == 'Via' && B.Type == 'Via' && ((A.inDiffPair('CAM1_CSI_D0') && B.NetName == 'GND') || (B.inDiffPair('CAM1_CSI_D0') && A.NetName == 'GND')) && A.enclosedByArea('CSI_CAM1_D0_SOURCE_RETURN') && B.enclosedByArea('CSI_CAM1_D0_SOURCE_RETURN')")
	(constraint clearance
		(min 0.15mm)
	)
)

(rule
