	(condition "A.Type == 'Via' && B.Type == 'Via' && ((A.inDiffPair('CAM1_CSI_D0') && B.NetName == 'GND') || (B.inDiffPair('CAM1_CSI_D0') && A.NetName == 'GND')) && A.enclosedByArea('CSI_CAM1_D0_TARGET_RETURN') && B.enclosedByArea('CSI_CAM1_D0_TARGET_RETURN')")
