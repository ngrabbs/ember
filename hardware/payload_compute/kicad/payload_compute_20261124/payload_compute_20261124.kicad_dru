(version
	1
)

(rule
	"CSI 95 ohm outer geometry"
	(condition "A.hasNetclass('CSI')")
	(constraint track_width
		(min 0.1501mm)
		(opt 0.1501mm)
		(max 0.1501mm)
	)
	(constraint diff_pair_gap
		(min 0.30mm)
		(opt 0.30mm)
		(max 0.30mm)
	)
	(constraint skew
		(max 0.15mm)
		(within_diff_pairs)
	)
	(constraint length
		(max 130mm)
	)
	(constraint via_count
		(max 2)
	)
)

(rule
	"PCIe 85 ohm outer geometry"
	(condition "A.hasNetclass('PCIE')")
	(constraint track_width
		(min 0.16mm)
		(opt 0.16mm)
		(max 0.16mm)
	)
	(constraint diff_pair_gap
		(min 0.15mm)
		(opt 0.15mm)
		(max 0.15mm)
	)
	(constraint skew
		(max 0.08mm)
		(within_diff_pairs)
	)
	(constraint length
		(max 100mm)
	)
	(constraint via_count
		(max 2)
	)
)

(rule
	"High speed outer layers only"
	(condition "(A.hasNetclass('CSI') || A.hasNetclass('PCIE')) && (A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu')")
	(constraint disallow track via)
)

(rule
	"Uncoupled high speed spacing 4h"
	(condition "A.Type == 'Track' && B.Type == 'Track' && (A.hasNetclass('CSI') || A.hasNetclass('PCIE')) && (B.hasNetclass('CSI') || B.hasNetclass('PCIE')) && !AB.isCoupledDiffPair()")
	(constraint clearance
		(min 0.40mm)
	)
)

(rule
	"PCIe TX RX separation 9h"
	(condition "A.Type == 'Track' && B.Type == 'Track' && ((A.NetName == 'PCIE0_MODULE_RX_*' && (B.NetName == 'PCIE0_MODULE_TX_*' || B.NetName == '/M2 Key E socket PCIe/M2E_HOST_TX_AC_*')) || (B.NetName == 'PCIE0_MODULE_RX_*' && (A.NetName == 'PCIE0_MODULE_TX_*' || A.NetName == '/M2 Key E socket PCIe/M2E_HOST_TX_AC_*')))")
	(constraint clearance
		(min 0.90mm)
	)
)

(rule
	"Coupled pair clearance"
	(condition "AB.isCoupledDiffPair() && (A.hasNetclass('CSI') || A.hasNetclass('PCIE'))")
	(constraint clearance
		(min 0.15mm)
	)
)

(rule
	"CSI_CAM1_CLK_MODULE_BREAKOUT bounded connector transition"
	(condition "A.inDiffPair('CAM1_CSI_CLK') && B.inDiffPair('CAM1_CSI_CLK') && A.enclosedByArea('CSI_CAM1_CLK_MODULE_BREAKOUT') && B.enclosedByArea('CSI_CAM1_CLK_MODULE_BREAKOUT')")
	(constraint diff_pair_gap
		(min 0.15mm)
		(max 0.39mm)
	)
)

(rule
	"CSI_CAM1_CLK_FFC_TRANSITION bounded connector transition"
	(condition "A.inDiffPair('CAM1_CSI_CLK') && B.inDiffPair('CAM1_CSI_CLK') && A.enclosedByArea('CSI_CAM1_CLK_FFC_TRANSITION') && B.enclosedByArea('CSI_CAM1_CLK_FFC_TRANSITION')")
	(constraint diff_pair_gap
		(min 0.15mm)
		(max 1.25mm)
	)
)

(rule
	"JLC component pad drilling separation"
	(condition "A.Type != 'Via' || B.Type != 'Via'")
	(constraint hole_to_hole
		(min 0.45mm)
	)
)

(rule
	"JLC via drilling separation"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole
		(min 0.20mm)
	)
)

(rule
	"CSI_CAM1_D0_MODULE_F bounded connector transition"
	(condition "A.inDiffPair('CAM1_CSI_D0') && B.inDiffPair('CAM1_CSI_D0') && A.enclosedByArea('CSI_CAM1_D0_MODULE_F') && B.enclosedByArea('CSI_CAM1_D0_MODULE_F')")
	(constraint diff_pair_gap
		(min 0.15mm)
		(max 0.55mm)
	)
)

(rule
	"CSI_CAM1_D0_MODULE_B bounded connector transition"
	(condition "A.inDiffPair('CAM1_CSI_D0') && B.inDiffPair('CAM1_CSI_D0') && A.enclosedByArea('CSI_CAM1_D0_MODULE_B') && B.enclosedByArea('CSI_CAM1_D0_MODULE_B')")
	(constraint diff_pair_gap
		(min 0.15mm)
		(max 0.55mm)
	)
)

(rule
	"CSI_CAM1_D0_FFC_B bounded connector transition"
	(condition "A.inDiffPair('CAM1_CSI_D0') && B.inDiffPair('CAM1_CSI_D0') && A.enclosedByArea('CSI_CAM1_D0_FFC_B') && B.enclosedByArea('CSI_CAM1_D0_FFC_B')")
