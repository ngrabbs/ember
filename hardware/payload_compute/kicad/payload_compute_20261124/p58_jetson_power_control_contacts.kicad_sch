	)
	(text "J3301 is one physical socket; all VDD and GND contacts and grounded mounts remain connected.\nFORCE_RECOVERY and MODULE_ID are NC for this externally provisioned, buck-powered SD-only prototype.\nVerify module shutdown and carrier I/O sequencing before the EPS cuts VBAT."
		(exclude_from_sim no)
		(at 279.908 176.53 0)
