	(text "EMBER PAYLOAD COMPUTE - NEXT PROTOTYPE / STAGE 3"
		(at 27.94 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "32253323-2175-4ed3-bd70-e3c6fa82c69b")
	)
	(text "Implemented:\nfixed3.3V AON buck"
		(at 63.5 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "20e71588-966e-46bd-aa5f-8dc455b4fe7e")
	)
	(text "Implemented: three autonomous limited / reverse-blocked bootstrap paths.\nUSB initial5V; bench6–8.4V; stack range still bounded by entry contract.\nSources below are requests, not attached-source voltage proof."
		(at 20.32 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "998e8ae4-4d86-4279-bf49-3e5adae735d2")
	)
	(text "OPEN BOUNDARIES / FAIL-OFF CORE\nSOURCE_OK_AON: raw windows, source presence, PD contract,\nselected bus, inrush and fault qualification are not captured.\nORIN_5V_WINDOW_OK and SHUTDOWN_OK_AON remain qualified receiver inputs.\nMCU requests, arm, clocks, ready and WDI need future STM32.\nBench jumper, IHU and MCU/debug connector hardware still pending.\nMCU_NRST_N shared watchdog output accepts only external OD drivers."
		(at 20.32 276.86 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "807b5926-bb73-4a7c-ad18-e42a8695cc0c")
	)
	(text "IMPLEMENTED HARDWARE OWNERSHIP\nMode startup latch / source-lock latch / one-hot choice.\nMODE_PERMISSION requires mode-compatible locked exclusive choice;\nflight also requires live IHU_PAYLOAD_EN high.\nMCU_CONTROL_READY includes WDT enabled/healthy, reset and MCU_READY.\nSOURCE_OK remains independent actual power qualification."
		(at 416.56 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "db43bd6c-39f6-49f6-9636-1bc19f5caeb2")
	)
	(text "PROTOTYPE QUALIFICATION GATES\nAON startup target0.200W / ceiling0.250W; active0.350W deferred.\nNew logic budget is conditional; cold buck ramp/inrush still unproven.\nSchmitt OD receiver thresholds and edges need full rail/ramp measurement.\nMode waits20ms reset release +10ms stable; lock1ms only once per AON cycle.\nSource request setup/hold1ms around1ms lock pulse.\nNo layout, fabrication, assembly or flight release."
		(at 416.56 292.1 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "d6916f72-ece7-432e-afc5-a008e982bc18")
	)
