	(text "000 and all multihot requests produce no choice.\nThese outputs identify a locked request; they do NOT prove source voltage, PD contract,\nraw attachment exclusivity, fault status, selected bus or inrush completion.\nNo hardware retarget after ordinary MCU reset; AON reset alone reopens the aperture.\nFirmware sets requests >=1ms before/after the first SOURCE_LOCK_CLK 1ms pulse.\nAll later lock pulses cannot change the stored request."
		(at 203.2 365.76 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 25 80 160 1)
			)
			(justify left top)
		)
		(uuid "d6bc6d95-9448-47cb-9791-d9a2af1045fd")
	)
