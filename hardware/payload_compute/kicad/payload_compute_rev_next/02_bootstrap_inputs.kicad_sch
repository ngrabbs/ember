  (text "CdVdt220nF / 20% allocation; output slew ~360–797V/s.\nCharging12.12uF switched input capacitance needs <=9.66mA at ramp end.\nThis arithmetic does not bound initial buck/output-cap charging load.\nBootstrap OR is independent of main immutable source selection.\nFault retry or complete AON loss must never synthesize a new arm."
    (at 20.32 210.82 0)
    (effects (font (size 1.5 1.5)) (justify left top))
    (uuid "9f0caa07-62e7-42f8-8b71-efde86021d5a")
  )
