	(text "POWER_PERMISSION = AON_RESET_N & SOURCE_OK_AON & MODE_PERMISSION\nMAIN_BUCK_REQUEST_OK = POWER_PERMISSION & MCU_MAIN_REQ & MCU_CONTROL_READY\nRUN_CLEAR_N = MAIN_BUCK_REQUEST_OK & ORIN_5V_WINDOW_OK & SHUTDOWN_OK_AON\nRUN_LATCH samples MCU_ARM_QUAL on rising MCU_ARM_CLK only while RUN_CLEAR_N is high.\nFault/recovery does not generate an arm edge. PRE_N tied high; Q_N and TPS3808 CT intentionally NC."
		(at 25.4 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ddaf2dc8-f8af-4993-9c7f-bb76b595b9c3")
	)
	(text "BOUNDARY / TIMING CONTRACT\nAll external high-true qualifiers and MCU controls have 10k pulldowns (about 0.342 mA worst at 3.3825 V / 9.9k).\nFuture drivers must meet LVC VIH >= 2.0 V / VIL <= 0.8 V with these loads, ramps and partial power checked.\nCT open: AON release 12-28 ms; not source/reference/module readiness. MR_N tied high.\nArm: keep CLK low, set D, wait >= 1 ms, pulse CLK >= 1 ms, lower CLK then D. Race/recovery tests remain.\nLogic request is not physical buck EN. RUN_LATCH is not direct 5 V Jetson POWER_EN."
		(at 25.4 240 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f87ad72-8f9c-417c-a0cb-f0214830d0d7")
	)
	(text "04 - AON RESET / PERMISSION / FRESH-ARM RUN CORE"
		(at 25.4 12.7 0)
		(effects
