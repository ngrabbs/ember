			(justify left top)
		)
		(uuid "25b1a76b-3a02-4ab0-863f-0d35deaff260")
	)
	(text_box "SO-DIMM MODULE CONNECTOR — TE 2309413-1, 260-pin 0.5 mm SO-DIMM. Pinout is governed by payload_carrier_pinmap.md. v0.1 module variant: Jetson Orin Nano devkit (microSD on module). MODULE_ID (pin 217) is tied to GND on the carrier to indicate 5V-only VDD_IN per DG-10931 §6.1. If a wide-range production module is later substituted, this tie must be revisited and the buck topology re-evaluated."
		(exclude_from_sim no)
		(at 68.58 25.2222 0)
		(size -55.88 22.86)
		(margins 0.9525 0.9525 0.9525 0.9525)
