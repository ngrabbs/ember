	)
	(text_box "@{\"Id\":\"DQTMYLI~{U}USWHCLAX\",\"ObjectType\":2} (100 nF input bypass) MUST be placed directly across VIN and GND pins with the shortest possible trace. This is the high-frequency commutation loop and is the most layout-critical component on the buck."
		(exclude_from_sim no)
		(at 35.56 256.3622 0)
		(size -27.94 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
