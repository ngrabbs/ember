	(text "USB 15 V main-path prototype - raw-powered enable clamp"
		(at 25.4 22.86 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5637f31e-cf5e-4276-b28b-a79cb130ae53")
	)
	(text "VDC is protected raw USB VBUS. ADMISSION_GRANT is a qualified hardware output, default low.\nQ1 clamps EN without AON power; Q2 releases the clamp when grant is high.\nAUXOFF/FLT are unused in this electrical fixture; a source-health interface is still required."
		(at 25.4 32.385 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "c02aed9a-7c46-41aa-9dcb-94f919f81daf")
	)
	(text "Prototype DC screen uses 25 C MOSFET data. Hot/cold leakage and ramps are unqualified.\nGrant driver: VOH >=2.4 V at this load; VOL <=0.4 V; power-off leakage <=10 uA.\nA 0.4 V grant-low level does not prove Q2 off: qualify a stronger low specification."
		(at 101.6 156.21 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "bf6730c8-06e3-428c-a7b3-7a368c4b30f9")
	)
	(text "4.7n EN capacitor slows admission; test hard-kill/fault-reset timing.\n10n dVdt and 100u output are study values. ITIMER open, no extended blanking.\nEntry protection, PD contract, source lock, IHU authorization and watchdog are external boundaries."
		(at 25.4 184.15 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "f63b829b-8b36-4ffc-9cb4-ecda35580914")
	)
