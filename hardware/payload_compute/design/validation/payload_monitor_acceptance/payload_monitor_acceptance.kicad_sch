	(text "Payload 5V window monitor — bounded circuit study"
		(at 38.1 15.24 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8df3e18d-a6dd-44da-adbc-e3cc0c3651fd")
	)
	(text "R1–R4: 0.1%, <=10ppm/C. C2: >=1uF effective at bias/temperature.\n+5V sense: module VDD and local ground. VIN_SELECTED: protected input, >=5V qualified.\nLow output = UV or OV fault. External run latch must hold shutdown; no auto restart.\nPWR_FLAGs represent external supplies. Passive MPNs/layout/timing remain to qualify."
		(at 38.1 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "864b72ea-f35e-4f33-ba46-1d5c91d3bd15")
