	(text "IHU receiver and source permission — bounded circuit study"
		(at 20.32 25.4 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "c97c3585-9560-43ad-b5d0-bf0c72dd444c")
	)
	(text "AON +3V3 only. IHU: 3.3 V push-pull, default low.\nCAN handles normal stops; IHU low hard-clears the downstream run latch.\nSource SELECTED/OK must come from qualified upstream hardware.\nNo hot-swap or rail-decay timing is established by this study."
		(at 330.2 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d0345648-22bd-4c64-8e35-d635686b76dd")
	)
	(text "C1–C9: one 100 nF bypass per gate; place next to its VCC/GND in the carrier layout."
		(at 20.32 294.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7fafc669-87c3-43d7-b29f-0cc5433e9606")
	)
	(text "Bench ignores IHU; stack requires IHU. Both source selections asserted inhibits permission. MODE_PERMISSION feeds the existing fault-cleared run latch."
		(at 20.32 404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a681636-7c83-4170-ad93-64700902713f")
	)
	(text "Default-low bias for push-pull inputs. External drivers are outside this study.\nAON_RESET_N uses the supervisor block's 10k pull-up; no pulldown here. R9 intentionally omitted."
		(at 20.32 345.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e267186e-3206-4ae6-8305-17f818b9d113")
	)
