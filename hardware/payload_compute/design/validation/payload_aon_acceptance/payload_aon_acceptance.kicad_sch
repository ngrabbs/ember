	(text "AON 3.3 V prototype regulator - PFM, RT tied to VCC (1 MHz)"
		(at 30.48 25.4 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "63d85101-2c73-4c8e-bcef-5599bb9829b0")
	)
	(text "VDC is the protected, limited, reverse-isolated bootstrap input.\nEntry protection and source OR are external boundaries, not implemented here.\nPassive values are study allocations; exact MPNs, derating and startup tests pending."
		(at 30.48 36.83 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "70484308-6e2d-4a66-995a-3b81fbbce72d")
	)
	(text "VCC is internal only; no external loads.\nPGOOD is intentionally unused; reset comes from the separate supervisor."
		(at 30.48 119.38 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "44496f74-5c76-48f7-b7fb-231f65d56af5")
	)
	(text "PWR_FLAG symbols model the external input/ground and the buck output for ERC.\nThey do not prove protection, startup regulation or power delivery."
		(at 30.48 135.89 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "1d7bec99-51e4-4122-93a0-acdde77f99f1")
	)
	(text "C1 effective capacitance >=4.7u at maximum qualified input.\nL1: Isat >=1.2 A; Irms >=0.6 A; DCR and temperature rise to qualify."
		(at 160.02 114.3 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left bottom)
		)
		(uuid "a829a13a-15c1-459e-9bae-0eebcdd39436")
	)
