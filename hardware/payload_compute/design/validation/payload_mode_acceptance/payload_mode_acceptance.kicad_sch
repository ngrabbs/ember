	(text "Bench-mode sampler: lock until AON reset"
		(at 25.4 12.7 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "438f451d-b9a1-4f07-a76d-b33d79e77b3f")
	)
	(text "U1 D=1: repeated clock pulses cannot unlock. U1 Q_N closes U2 latch after locking.\nAON reset alone unlocks; STM32 reset is a separate signal and must not drive CLR_N.\nKeep main request low during sampling. Require 20 ms stable jumper, then lock.\nAfter locking wait 1 ms and read back mode/lock before enabling a source or buck.\nBENCH_AUTH is only the bench branch; IHU receiver/source gating not implemented.\nJ1 and passives are schematic concepts without accepted production MPNs/footprints."
		(at 25.4 158.75 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "a1b7834f-af71-4cc8-b9a9-81990b7648e9")
	)
