  (text "Payload run latch / AON reset acceptance study"
    (at 25.4 12.7 0)
    (effects (font (size 1.8 1.8) (bold yes)) (justify left top))
    (uuid "ed00fa07-a4e0-40a1-ba3a-629fd5ae6274")
  )
  (text "Qualified 3.3 V boundary signals only; module/IHU receivers are not implemented here.\nRUN_LATCH requires a fresh MCU_ARM_CLK rising edge with MCU_ARM_QUAL high.\nAny missing clear condition resets Q asynchronously. Clock is never gated.\nRUN_LATCH is NOT the Jetson POWER_EN electrical interface.\nCT intentionally open: reset release 12-28 ms. Q_N intentionally unused.\nRail discharge, watchdog, mode sampler and level interfaces require separate qualification."
    (at 25.4 164 0)
    (effects (font (size 1.1 1.1)) (justify left top))
    (uuid "72070838-b2ee-415c-8423-2c385322a96b")
  )
