[Unit]
Description=EMBER one-shot Yamcs fire-check RF command link
After=network-online.target
Wants=network-online.target

[Service]
User=ngrabbs
Environment=PYTHONPATH=/opt/ember-fire/ember
ExecStart=/usr/bin/python3 -u /opt/ember-fire/bpsk/fire_uplink.py --output /home/ngrabbs/work/ember-fire-rf-evidence
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
