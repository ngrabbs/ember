[Unit]
Description=EMBER bounded COMMS fire-check receive/reply window
After=network-online.target
Wants=network-online.target

[Service]
User=ngrabbs
Environment=PYTHONPATH=/opt/ember-fire/ember
ExecStart=/usr/bin/python3 -u /opt/ember-fire/bpsk/fire_arm.py --device /dev/serial/by-id/usb-Raspberry_Pi_Pico_E663682593639D39-if00
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
