diff --git a/openair2/LAYER2/MAC/tests/test_emtc_ul_harq.c b/openair2/LAYER2/MAC/tests/test_emtc_ul_harq.c
new file mode 100644
index 0000000..3a67192
--- /dev/null
+++ b/openair2/LAYER2/MAC/tests/test_emtc_ul_harq.c
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include <assert.h>
+#include "../emtc_ul_harq.h"
+
+int main(void)
+{
+  for (int legacy = 0; legacy < 8; legacy++) {
+    assert(emtc_ul_rx_harq_pid(0, legacy) == legacy);
+    for (unsigned int ce = 1; ce <= 4; ce++)
+      assert(emtc_ul_rx_harq_pid(ce, legacy) == 0);
+  }
+  return 0;
+}
