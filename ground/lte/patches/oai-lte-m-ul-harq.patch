diff --git a/openair2/LAYER2/MAC/emtc_ul_harq.h b/openair2/LAYER2/MAC/emtc_ul_harq.h
new file mode 100644
index 0000000..0ea0619
--- /dev/null
+++ b/openair2/LAYER2/MAC/emtc_ul_harq.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#ifndef EMTC_UL_HARQ_H
+#define EMTC_UL_HARQ_H
+
+/* Match the single-process BL/CE uplink scheduler and PHY receive path. */
+static inline int emtc_ul_rx_harq_pid(unsigned int rach_resource_type, int legacy_harq_pid)
+{
+  return rach_resource_type > 0 ? 0 : legacy_harq_pid;
+}
+
+#endif
