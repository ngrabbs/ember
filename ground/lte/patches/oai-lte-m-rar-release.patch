diff --git a/openair1/PHY/LTE_TRANSPORT/emtc_dlsch_context.h b/openair1/PHY/LTE_TRANSPORT/emtc_dlsch_context.h
new file mode 100644
index 0000000..1de6b4a
--- /dev/null
+++ b/openair1/PHY/LTE_TRANSPORT/emtc_dlsch_context.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#ifndef EMTC_DLSCH_CONTEXT_H
+#define EMTC_DLSCH_CONTEXT_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Called after PDSCH mapping: retain UE HARQ processes awaiting feedback. */
+static inline bool emtc_release_rar_harq(uint8_t *release_after_tx, uint16_t *harq_mask, uint8_t harq_pid)
+{
+  if (!*release_after_tx)
+    return false;
+  *harq_mask &= (uint16_t)~(1U << harq_pid);
+  *release_after_tx = 0;
+  return true;
+}
+#endif
