diff --git a/openair1/PHY/LTE_TRANSPORT/tests/test_emtc_dlsch_context.c b/openair1/PHY/LTE_TRANSPORT/tests/test_emtc_dlsch_context.c
new file mode 100644
index 0000000..3b91987
--- /dev/null
+++ b/openair1/PHY/LTE_TRANSPORT/tests/test_emtc_dlsch_context.c
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include <assert.h>
+#include "../emtc_dlsch_context.h"
+
+int main(void)
+{
+  uint8_t release = 1;
+  uint16_t mask = 1;
+  assert(emtc_release_rar_harq(&release, &mask, 0));
+  assert(mask == 0 && release == 0);
+  assert(!emtc_release_rar_harq(&release, &mask, 0));
+  mask = 1;
+  assert(!emtc_release_rar_harq(&release, &mask, 0));
+  assert(mask == 1);
+  release = 1;
+  mask = 0x81;
+  assert(emtc_release_rar_harq(&release, &mask, 7));
+  assert(mask == 1 && release == 0);
+  return 0;
+}
