diff --git a/openair2/LAYER2/MAC/tests/test_emtc_msg4.c b/openair2/LAYER2/MAC/tests/test_emtc_msg4.c
new file mode 100644
index 0000000..976758b
--- /dev/null
+++ b/openair2/LAYER2/MAC/tests/test_emtc_msg4.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#include "../emtc_msg4.h"
+#include <stdio.h>
+
+int main(void)
+{
+  const struct {
+    int round;
+    int transmitted_round;
+    int feedback;
+    emtc_msg4_action_t expected;
+  } cases[] = {
+    {0, 0, 0, EMTC_MSG4_WAIT},
+    {1, 0, 4, EMTC_MSG4_RETRY},
+    {1, 1, 0, EMTC_MSG4_WAIT},
+    {2, 1, 2, EMTC_MSG4_RETRY},
+    {3, 2, 4, EMTC_MSG4_RETRY},
+    {3, 3, 0, EMTC_MSG4_WAIT},
+    {8, 0, 1, EMTC_MSG4_ACK},
+    {8, 3, 1, EMTC_MSG4_ACK},
+    {8, 3, 2, EMTC_MSG4_FAIL},
+    {8, 3, 4, EMTC_MSG4_FAIL},
+    {8, 3, 0, EMTC_MSG4_FAIL},
+  };
+  for (unsigned int i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+    emtc_msg4_action_t actual = emtc_msg4_action(cases[i].round, cases[i].transmitted_round, cases[i].feedback);
+    if (actual != cases[i].expected) {
+      fprintf(stderr, "Msg4 action case %u: expected %d, got %d\n", i, cases[i].expected, actual);
+      return 1;
+    }
+  }
+  return 0;
+}
