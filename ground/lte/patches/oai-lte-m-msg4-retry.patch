diff --git a/openair2/LAYER2/MAC/emtc_msg4.h b/openair2/LAYER2/MAC/emtc_msg4.h
new file mode 100644
index 0000000..7130234
--- /dev/null
+++ b/openair2/LAYER2/MAC/emtc_msg4.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: LicenseRef-CSSL-1.0 */
+#ifndef EMTC_MSG4_H
+#define EMTC_MSG4_H
+
+typedef enum {
+  EMTC_MSG4_WAIT,
+  EMTC_MSG4_RETRY,
+  EMTC_MSG4_ACK,
+  EMTC_MSG4_FAIL,
+} emtc_msg4_action_t;
+
+/* MAC uses round 8 for both an ACK and exhausted retries; preserve the feedback. */
+static inline emtc_msg4_action_t emtc_msg4_action(int round, int transmitted_round, int feedback)
+{
+  if (round == 8)
+    return feedback == 1 ? EMTC_MSG4_ACK : EMTC_MSG4_FAIL;
+  if (round > transmitted_round && round < 4)
+    return EMTC_MSG4_RETRY;
+  return EMTC_MSG4_WAIT;
+}
+
+#endif
