[Unit]
Description=Optional EMBER SDRB transponder and passive CAN adapter

[Service]
Type=simple
WorkingDirectory=%h/ember-uhf-20261003
ExecStart=/usr/bin/python3 %h/ember-uhf-20261003/supervisor.py serve --config %h/ember-uhf-20261003/sdrb.json --transmit
Restart=no
TimeoutStopSec=120
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
