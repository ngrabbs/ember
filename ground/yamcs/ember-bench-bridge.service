[Unit]
Description=EMBER single-owner IHU serial bench telemetry and commands
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=ngrabbs
ExecStart=/usr/bin/python3 -u /opt/ember-bench/ember/payload_bridge.py --device /dev/serial/by-id/usb-Raspberry_Pi_Pico_DF641455DB822427-if00 --poll-eps --cells 2 --rsnsb-ohms 0.01 --rsnsi-ohms 0.01
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
