# ---------------------------------------------------------------------------
# EMBER — repository ignore rules
# ---------------------------------------------------------------------------

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / tooling scratch
.claude
.vscode
*~
*.tmp
*.bak
*.bck

# ---------------------------------------------------------------------------
# EDA source trees — held outside this repo.
# Board design lives in the CAD workspace, not here; only the written design
# docs, fabrication releases, and measured results are tracked.
# ---------------------------------------------------------------------------
**/altium/
**/kicad/
*.SchDoc
*.PcbDoc
*.PrjPcb
*.PrjPcbStructure
*.PcbLib
*.SchLib
*.OutJob
*.RUL
*.Cam
*-cache.lib
*.kicad_pcb
*.kicad_sch
*.kicad_pro
*.kicad_prl
*.kicad_sym
*.kicad_mod
*.kicad_dru
*-backups/
fp-info-cache
_autosave-*
\#auto_saved_files#
~*.lck

# ---------------------------------------------------------------------------
# LTSpice — keep the schematics (.asc/.asy) and netlists (.net).
# Everything below is regenerated by re-running the simulation.
# ---------------------------------------------------------------------------
*.raw
*.fft
*.db
*.plt
*.imp
*.prm
*.log

# ---------------------------------------------------------------------------
# Firmware build artifacts (CMake + Pico SDK output trees)
# ---------------------------------------------------------------------------
firmware/**/build/
*.uf2
*.elf
*.elf.map
*.hex
*.bin
firmware/**/*.a
firmware/**/*.o
firmware/**/.vscode/
firmware/**/compile_commands.json
firmware/**/.cache/

# ---------------------------------------------------------------------------
# Course material kept local — not part of the published design record
# ---------------------------------------------------------------------------
docs/weekly_updates/
docs/senior_design/
