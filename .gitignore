# ---------------------------------------------------------------------------
# EMBER — repository ignore rules
# ---------------------------------------------------------------------------

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / tooling scratch
.konnect/
__pycache__/
*.py[cod]
.claude
.vscode
*~
*.tmp
*.bak
*.bck

# ---------------------------------------------------------------------------
# Altium — not tracked. The binary .SchDoc/.PcbDoc formats do not diff, and
# Altium's History/ and __Previews/ trees dwarf the design itself. Altium
# board design lives in the CAD workspace; only the written design record,
# fabrication releases, and measured results are tracked here.
# ---------------------------------------------------------------------------
**/altium/
*.SchDoc
*.PcbDoc
*.PrjPcb
*.PrjPcbStructure
*.PcbLib
*.SchLib
*.OutJob
*.RUL
*.Cam
*-cache.lib

# ---------------------------------------------------------------------------
# KiCad — tracked. .kicad_sch/.kicad_pcb/.kicad_pro are plain-text
# S-expressions: retain the project, sheets, board and libraries. Ignore only
# generated/per-user state; make design changes through KiCad-aware tools.
# ---------------------------------------------------------------------------
*.kicad_prl
*-backups/
fp-info-cache
# KiCad 10 Local History — automatic snapshots, kept in its own nested git
# repo. KiCad manages it; tracking it would embed a repo inside this one.
.history/
_autosave-*
\#auto_saved_files#
~*.lck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
# hand-made and tool-made backups alongside a sheet, e.g. Foo.kicad_sch.bakh
*.kicad_sch.bak*
*.kicad_pcb.bak*
*.kicad_pro.bak*
*.sch-bak
*-save.kicad_pcb
*-save.pro
*.000

# ---------------------------------------------------------------------------
# LTSpice — keep the schematics (.asc/.asy) and netlists (.net).
# Everything below is regenerated by re-running the simulation.
# ---------------------------------------------------------------------------
*.raw
*.fft
*.db
*.plt
*.imp
*.prm
*.log

# ---------------------------------------------------------------------------
# Firmware build artifacts (CMake + Pico SDK output trees)
# ---------------------------------------------------------------------------
firmware/**/build/
*.uf2
*.elf
*.elf.map
*.hex
*.bin
firmware/**/*.a
firmware/**/*.o
firmware/**/.vscode/
firmware/**/compile_commands.json
firmware/**/.cache/

# ---------------------------------------------------------------------------
# Course material kept local — not part of the published design record
# ---------------------------------------------------------------------------
docs/weekly_updates/
docs/senior_design/

# Disposable comms exports; accepted evidence belongs in verification/.
# Scope netlists here so LTspice source .net files remain tracked.
/hardware/comms/kicad/*.net
/hardware/comms/kicad/*.rpt
/hardware/comms/design/*_preview.txt
/hardware/comms/design/latest_native_*.rpt
/hardware/comms/design/spice_output.txt
/hardware/comms/design/analysis/output/
